<Window x:Class="HeartProtocol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heart Protocol"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#080A0F"
        Foreground="#E7EAF0"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_KeyDown">

    <Window.Resources>

        <Style x:Key="TerminalButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#E7EAF0"/>

            <Setter Property="Background"
                    Value="#10141C"/>

            <Setter Property="BorderBrush"
                    Value="#37404F"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="24,12"/>

            <Setter Property="FontFamily"
                    Value="Cascadia Code"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#FF3158"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#171C26"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#242B37"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="TerminalText"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Cascadia Code"/>

            <Setter Property="Foreground"
                    Value="#7CFFB2"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>

    </Window.Resources>


    <Grid x:Name="RootGrid"
          Background="#080A0F">


        <!-- ====================================================== -->
        <!-- LOGIN -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneLogin"
              Background="#080A0F">

            <StackPanel Width="570"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="ĐI TÌM TÌNH YÊU❤."
                           FontFamily="Cascadia Code"
                           FontWeight="Bold"
                           FontSize="34"
                           Foreground="#E7EAF0"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                           FontFamily="Cascadia Code"
                           Foreground="#37404F"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,38"/>

                <TextBlock Text="XÁC MINH TÌNH YÊU."
                           FontFamily="Cascadia Code"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="#7CFFB2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>

                <TextBlock Text="Cho em biết tên của chị nho."
                           FontFamily="Segoe UI"
                           FontSize="18"
                           Foreground="#AAB2C0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <Border Background="#0D1118"
                        BorderBrush="#37404F"
                        BorderThickness="1"
                        CornerRadius="7">

                    <TextBox x:Name="NameInput"
                             Background="Transparent"
                             Foreground="#E7EAF0"
                             CaretBrush="#FF3158"
                             BorderThickness="0"
                             FontFamily="Cascadia Code"
                             FontSize="21"
                             Padding="20,15"
                             TextAlignment="Center"
                             KeyDown="NameInput_KeyDown"/>

                </Border>

                <Button x:Name="LoginButton"
                        Content="[ XÁC NHẬN ]"
                        Style="{StaticResource TerminalButton}"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="LoginStatusText"
                           FontFamily="Cascadia Code"
                           FontSize="14"
                           Foreground="#FF3158"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ====================================================== -->
        <!-- BOOT -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneBoot"
              Visibility="Collapsed"
              Opacity="0"
              Background="#080A0F"
              MouseLeftButtonDown="SceneBoot_MouseLeftButtonDown">

            <Grid Width="900"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="BootText"
                               Style="{StaticResource TerminalText}"
                               FontSize="21"
                               LineHeight="32"/>

                    <TextBlock x:Name="CursorBlock"
                               Text="█"
                               Style="{StaticResource TerminalText}"
                               FontSize="22"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>

        </Grid>


        <!-- ====================================================== -->
        <!-- SCAN -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneScan"
              Visibility="Collapsed"
              Opacity="0"
              Background="#080A0F">

            <Border Width="820"
                    Padding="45"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="ĐI TÌM TÌNH YÊU ❤"
                               FontFamily="Cascadia Code"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E7EAF0"/>

                    <TextBlock Text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                               FontFamily="Cascadia Code"
                               Foreground="#39414D"
                               FontSize="16"
                               Margin="0,8,0,24"/>

                    <TextBlock Text="Đang quét hệ thống..."
                               Style="{StaticResource TerminalText}"
                               Margin="0,0,0,12"/>

                    <ProgressBar x:Name="ScanProgress"
                                 Height="7"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#7CFFB2"
                                 Background="#181E27"/>

                    <TextBlock x:Name="ScanPercentText"
                               Text="0%"
                               Style="{StaticResource TerminalText}"
                               HorizontalAlignment="Right"
                               Margin="0,8,0,25"/>

                    <TextBlock x:Name="ScanWarningText"
                               Visibility="Collapsed"
                               Text="CẢNH BÁO&#x0a;&#x0a;Lỗi rồi lỗi rồi."
                               FontFamily="Cascadia Code"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#FF3158"
                               Margin="0,8,0,24"/>

                    <TextBlock x:Name="ProcessText"
                               FontFamily="Cascadia Code"
                               Foreground="#E7EAF0"
                               FontSize="17"
                               LineHeight="29"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="InspectQuestion"
                               Visibility="Collapsed"
                               Text="Chị có muốn biết điều gì đang xảy ra không?"
                               FontFamily="Cascadia Code"
                               Foreground="#7CFFB2"
                               FontSize="17"
                               Margin="0,30,0,18"/>

                    <Button x:Name="InspectButton"
                            Visibility="Collapsed"
                            Content="[ CÓ ]"
                            Style="{StaticResource TerminalButton}"
                            HorizontalAlignment="Left"
                            Click="InspectButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- HEART -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneHeart"
              Visibility="Collapsed"
              Opacity="0"
              Background="#080A0F">

            <Canvas x:Name="HeartCanvas"
                    IsHitTestVisible="False"/>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="BigHeart"
                           Text="❤"
                           FontFamily="Segoe UI Symbol"
                           FontSize="190"
                           Foreground="#FF3158"
                           HorizontalAlignment="Center"
                           Cursor="Hand"
                           RenderTransformOrigin="0.5,0.5"
                           MouseLeftButtonDown="BigHeart_MouseLeftButtonDown">

                    <TextBlock.RenderTransform>

                        <ScaleTransform x:Name="BigHeartScale"
                                        ScaleX="1"
                                        ScaleY="1"/>

                    </TextBlock.RenderTransform>

                    <TextBlock.Effect>

                        <DropShadowEffect Color="#FF3158"
                                          BlurRadius="35"
                                          ShadowDepth="0"
                                          Opacity="0.55"/>

                    </TextBlock.Effect>

                </TextBlock>

                <TextBlock Text="Đã phát hiện đối tượng."
                           FontFamily="Cascadia Code"
                           Foreground="#E7EAF0"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,8"/>

                <TextBlock Text="Nhấn vào trái tim để biết thêm chi tiết."
                           FontFamily="Cascadia Code"
                           Foreground="#7CFFB2"
                           FontSize="16"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>


        <!-- ====================================================== -->
        <!-- MEMORY -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneMemory"
              Visibility="Collapsed"
              Opacity="0"
              Background="#080A0F">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Width="900"
                            Margin="0,60,0,60"
                            HorizontalAlignment="Center">

                    <TextBlock Text="LỖI ĐÃ ĐƯỢC GIẢI MÃ"
                               FontFamily="Cascadia Code"
                               FontWeight="Bold"
                               Foreground="#E7EAF0"
                               FontSize="27"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Hãy mở từng mảnh theo thứ tự nha."
                               FontFamily="Cascadia Code"
                               Foreground="#7CFFB2"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,35"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button x:Name="FirstMemoryButton"
                                Content="First"
                                Tag="1"
                                Margin="8"
                                Style="{StaticResource TerminalButton}"
                                Click="MemoryButton_Click"/>

                        <Button x:Name="SecondMemoryButton"
                                Content="Second"
                                Tag="2"
                                Margin="8"
                                IsEnabled="False"
                                Style="{StaticResource TerminalButton}"
                                Click="MemoryButton_Click"/>

                        <Button x:Name="LastMemoryButton"
                                Content="Last"
                                Tag="3"
                                Margin="8"
                                IsEnabled="False"
                                Style="{StaticResource TerminalButton}"
                                Click="MemoryButton_Click"/>

                    </StackPanel>

                    <Border Background="#0D1118"
                            BorderBrush="#242C38"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="30"
                            Margin="0,35,0,0"
                            MinHeight="240">

                        <TextBlock x:Name="MemoryText"
                                   FontFamily="Segoe UI"
                                   FontSize="22"
                                   Foreground="#E7EAF0"
                                   TextWrapping="Wrap"
                                   LineHeight="34"
                                   TextAlignment="Center"/>

                    </Border>

                    <Button x:Name="MemoryContinueButton"
                            Visibility="Collapsed"
                            Opacity="0"
                            Content="[ TIẾP TỤC ]"
                            Style="{StaticResource TerminalButton}"
                            BorderBrush="#FF3158"
                            FontSize="17"
                            HorizontalAlignment="Center"
                            Margin="0,28,0,0"
                            Click="MemoryContinueButton_Click"/>

                    <TextBlock x:Name="AnalysisCompleteText"
                               Visibility="Collapsed"
                               Text="GIẢI MÃ HOÀN TẤT"
                               Foreground="#FF3158"
                               FontFamily="Cascadia Code"
                               FontWeight="Bold"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Margin="0,25,0,0"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>


        <!-- ====================================================== -->
        <!-- DECRYPT -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneDecrypt"
              Visibility="Collapsed"
              Opacity="0"
              Background="#080A0F">

            <StackPanel Width="820"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="PHÂN TÍCH DANH TÍNH"
                           FontFamily="Cascadia Code"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#E7EAF0"
                           Margin="0,0,0,30"/>

                <TextBlock x:Name="DecryptTerminal"
                           Style="{StaticResource TerminalText}"
                           FontSize="18"
                           LineHeight="30"
                           MinHeight="145"/>

                <ProgressBar x:Name="DecryptProgress"
                             Visibility="Collapsed"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#191E27"
                             Foreground="#FF3158"
                             Margin="0,25,0,12"/>

                <TextBlock x:Name="DecryptBarText"
                           FontFamily="Cascadia Code"
                           Foreground="#FF3158"
                           FontSize="16"
                           Margin="0,0,0,30"/>

                <Button x:Name="SecretButton"
                        Visibility="Collapsed"
                        Content="SECRET Ở ĐÂY.exe"
                        Style="{StaticResource TerminalButton}"
                        BorderBrush="#FF3158"
                        HorizontalAlignment="Left"
                        Click="SecretButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- ====================================================== -->
        <!-- FINAL -->
        <!-- ====================================================== -->

        <Grid x:Name="SceneFinal"
              Visibility="Collapsed"
              Background="#080A0F">

            <Canvas x:Name="FinalHeartCanvas"
                    IsHitTestVisible="False"/>

            <ScrollViewer x:Name="FinalScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="FinalContent"
                            Visibility="Collapsed"
                            Width="900"
                            Margin="0,28,0,55"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="FinalHeart"
                               Text="❤"
                               Foreground="#FF3158"
                               FontFamily="Segoe UI Symbol"
                               FontSize="78"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">

                        <TextBlock.RenderTransform>

                            <ScaleTransform x:Name="FinalHeartScale"
                                            ScaleX="1"
                                            ScaleY="1"/>

                        </TextBlock.RenderTransform>

                        <TextBlock.Effect>

                            <DropShadowEffect Color="#FF3158"
                                              BlurRadius="25"
                                              ShadowDepth="0"
                                              Opacity="0.5"/>

                        </TextBlock.Effect>

                    </TextBlock>


                    <TextBlock x:Name="FinalIntroText"
                               FontFamily="Segoe UI"
                               Foreground="#E7EAF0"
                               FontSize="20"
                               LineHeight="30"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,14,0,18"/>


                    <TextBlock x:Name="FinalLeadText"
                               FontFamily="Segoe UI"
                               Foreground="#E7EAF0"
                               FontSize="20"
                               LineHeight="30"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>


                    <TextBlock x:Name="HerNameText"
                               Visibility="Collapsed"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="48"
                               Foreground="#FF3158"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,20">

                        <TextBlock.Effect>

                            <DropShadowEffect Color="#FF3158"
                                              BlurRadius="25"
                                              ShadowDepth="0"
                                              Opacity="0.45"/>

                        </TextBlock.Effect>

                    </TextBlock>


                    <TextBlock x:Name="FinalLoveText"
                               FontFamily="Segoe UI"
                               Foreground="#E7EAF0"
                               FontSize="21"
                               LineHeight="31"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>


                    <TextBlock x:Name="FinalQuestionText"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="#E7EAF0"
                               FontSize="27"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>


                    <StackPanel x:Name="FinalButtons"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Content="ĐỒNG Ý ❤"
                                Margin="8"
                                Style="{StaticResource TerminalButton}"
                                BorderBrush="#FF3158"
                                FontSize="16"
                                Padding="24,11"
                                Click="YesButton_Click"/>

                        <Button Content="KHÔNG ĐỒNG Ý :>"
                                Margin="8"
                                Style="{StaticResource TerminalButton}"
                                FontSize="16"
                                Padding="24,11"
                                Click="ThinkButton_Click"/>

                    </StackPanel>


                    <TextBlock x:Name="FinalStatusText"
                               FontFamily="Segoe UI"
                               Foreground="#7CFFB2"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,18,0,0"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>


        <!-- ====================================================== -->
        <!-- BUILD -->
        <!-- ====================================================== -->

        <TextBlock x:Name="BuildStamp"
                   Visibility="Collapsed"
                   Text="Bản dựng 14.09.2026"
                   FontFamily="Cascadia Code"
                   FontSize="11"
                   Foreground="#48515E"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,18,12"/>


        <!-- ====================================================== -->
        <!-- NOTE -->
        <!-- ====================================================== -->

        <Grid x:Name="DeveloperNoteOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="100"
              Background="#E6080A0F">

            <Border Width="650"
                    Padding="40"
                    Background="#0D1118"
                    BorderBrush="#FF3158"
                    BorderThickness="1"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Ghi chú của người viết:"
                               FontFamily="Cascadia Code"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#FF3158"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Dù chị chọn câu trả lời nào,&#x0a;em cũng cảm ơn chị vì đã đọc đến tận đây :))&#x0a;&#x0a;Ít nhất hôm nay em cũng đủ can đảm&#x0a;để thành thật với cảm xúc của mình.&#x0a;&#x0a;Còn một chuyện thì chắc chắn...&#x0a;em thích chị thật. ❤"
                               FontFamily="Segoe UI"
                               FontSize="23"
                               Foreground="#E7EAF0"
                               LineHeight="35"
                               TextWrapping="Wrap"/>

                    <Button Content="[ ĐÓNG ]"
                            Style="{StaticResource TerminalButton}"
                            HorizontalAlignment="Left"
                            Margin="0,30,0,0"
                            Click="CloseDeveloperNote_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>